{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Запуск с отладчиком",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/app.js",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "env": { "NODE_ENV": "development" }
    },
    {
      "name": "Подключиться к запущенному процессу",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}

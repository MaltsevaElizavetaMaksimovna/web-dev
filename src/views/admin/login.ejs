<%- include('../partials/head', { title: title }) %>
<div class="login">
  <div class="login__card">
    <div class="login__head">
      <div class="login__mark" aria-hidden="true">К</div>
      <h1 class="login__title">Панель управления</h1>
      <p class="login__subtitle">Доступ только для администратора каталога</p>
    </div>

    <%# Сообщения об ошибках проверки данных или неверных учётных данных %>
    <% if (errors && errors.length > 0) { %>
      <div class="alert alert--error" role="alert">
        <div>
          <% if (errors.length === 1) { %>
            <%= errors[0] %>
          <% } else { %>
            <strong>Не удалось выполнить вход:</strong>
            <ul class="alert__list">
              <% errors.forEach(function (error) { %>
                <li><%= error %></li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </div>
    <% } %>

    <form method="POST" action="/admin/login" autocomplete="on">
      <div class="form-group">
        <label class="form-label" for="login">Логин</label>
        <input class="input" type="text" id="login" name="login"
               value="<%= login %>"
               required maxlength="50" autocomplete="username" autofocus>
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Пароль</label>
        <input class="input" type="password" id="password" name="password"
               required maxlength="100" autocomplete="current-password">
      </div>

      <button class="btn btn--primary btn--block" type="submit">Войти</button>
    </form>

    <p class="login__hint">
      Учётная запись для проверки работы:<br>
      <code>admin</code> &nbsp;/&nbsp; <code>admin123</code>
    </p>

    <p style="text-align: center; margin: 16px 0 0;">
      <a class="btn btn--ghost btn--sm" href="/">← Вернуться в каталог</a>
    </p>
  </div>
</div>
</body>
</html>
